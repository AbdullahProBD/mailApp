# -----------------------------------------------------------------------------
# Mail app environment variables
# Copy this file to `.env.local` for local development. Never commit real values.
# -----------------------------------------------------------------------------

# The single owner of this application. Must be the exact, lowercase address
# that may sign in. There is no public sign-up.
OWNER_EMAIL=

# One-time secret required by the first-run setup wizard. Minimum 32 characters.
# Generate with: openssl rand -base64 48
SETUP_TOKEN=

# Postgres/Supabase connection string used by the server only.
DATABASE_URL=

# Supabase project URL and service-role key. Server-side only, never NEXT_PUBLIC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Versioned AES-256-GCM keys, comma-separated, newest first. Each entry is
# vN:<base64> where <base64> decodes to exactly 32 bytes, e.g. v2:<base64>.
# Generate key material with: openssl rand -base64 32
ENCRYPTION_KEYS=

# Pepper for hashing session tokens and one-time codes. Minimum 32 characters.
# Generate with: openssl rand -base64 48
SESSION_PEPPER=

# Bearer secret for the scheduler/cron dispatcher. Minimum 32 characters.
CRON_SECRET=

# Upstash Redis REST credentials for distributed rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical public URL of the deployment. HTTPS is required in production.
APP_URL=http://localhost:3000

# Session lifetimes in minutes and hours. Idle defaults to 30 minutes,
# absolute to 12 hours. "Remember this device" only lifts the idle timeout.
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=12

# Send-safety limits. Drip spacing defaults to 20 seconds (3 emails/minute) and
# is bounded to 5-3600 seconds. Batch, pending and daily caps are hard limits
# enforced in code and in the database.
DRIP_DEFAULT_INTERVAL_SECONDS=20
MAX_BATCH_SIZE=500
MAX_PENDING_SCHEDULED_EMAILS=2000
DEFAULT_DAILY_SEND_CAP=500

# Have I Been Pwned k-anonymity range API. Tests point this at a local stub.
HIBP_API_URL=https://api.pwnedpasswords.com

# Optional public URL used by the browser bundle (no secrets).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional error monitoring. Configure PII scrubbing before enabling.
SENTRY_DSN=

# Optional OAuth applications for mail providers. Server-side only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
